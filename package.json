{
  "name": "dsh-prompt-inject",
  "version": "0.1.1-rc.4",
  "description": "System-prompt template injection for DeepSeek Harness: manage named prompt templates and inject the selected one (global default plus per-workspace overrides) into every session's system prompt.",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "lib",
    "locale",
    "icon.svg",
    "cordis.patch.yml",
    "README.md",
    "README.en.md",
    "CHANGELOG.md",
    "docs/COMPATIBILITY.md",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md",
    "docs/UPSTREAM.md",
    "assets"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-settings"
      ]
    },
    "manifestVersion": 1
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "cordis",
    "plugin",
    "prompt",
    "template",
    "system-prompt",
    "prompt-injection",
    "dsh-plugin"
  ],
  "engines": {
    "node": ">=24",
    "dsh": "0.2.0-rc.2 || 0.2.1-rc.2 || 0.2.1-rc.3"
  },
  "license": "MIT",
  "author": "H1a3x",
  "repository": {
    "type": "git",
    "url": "https://github.com/379385796-sys/dsh-prompt-inject.git"
  },
  "bugs": {
    "url": "https://github.com/379385796-sys/dsh-prompt-inject/issues"
  },
  "homepage": "https://github.com/379385796-sys/dsh-prompt-inject#readme",
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/schemastery": "^3.18.0",
    "react": "^18.0.0 || ^19.0.0",
    "@deepseek-ai/dsh-settings": "0.2.0-rc.2 || 0.2.1-rc.2 || 0.2.1-rc.3",
    "@deepseek-ai/dsh-system-prompt": "0.2.0-rc.2 || 0.2.1-rc.2 || 0.2.1-rc.3",
    "@deepseek-ai/dsh-client-ui-settings": "0.2.0-rc.2 || 0.2.1-rc.2 || 0.2.1-rc.3"
  },
  "scripts": {
    "build": "node --check lib/index.js && node --check lib/client.js",
    "check": "npm run build && npm test",
    "test": "node --test tests/*.test.mjs",
    "pack:release": "node scripts/pack-release.mjs"
  },
  "icon": "./icon.svg"
}
